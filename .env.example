# Optional. When set, this takes priority over AGENT_API_URL below: /api/agent/chat and
# /api/agent/confirm run turns through a real TrueForge harness (npx @truefoundry/trueforge)
# instead of the generic proxy or the local mock. Run `pnpm harness` then `pnpm setup:agent`
# before `pnpm dev`.
TRUEFORGE_BASE_URL=
TRUEFORGE_AGENT_NAME=
TRUEFORGE_MODEL=

# Base URL this Next.js app is reachable at — used by `pnpm setup:agent` to register our
# own MCP tool server (app/api/mcp/route.ts) with TrueForge. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Suggested default target for record_demo/inspect_page when nobody names a URL — the agent
# can record any http(s) URL it's told to, this is just a fallback. Defaults to
# http://localhost:3100 — run something there, e.g. `cd ../hydra_agents && npx next dev -p 3100`.
DEMO_APP_URL=

# Optional. When set, app/api/mcp/route.ts requires a matching x-mcp-secret header (otherwise
# unauthenticated). pnpm setup:agent registers the same value on the MCP server manifest.
MCP_SECRET=

# Required for record_demo's narration steps (lib/tools/tts.ts calls OpenAI's TTS API
# directly — separate from whatever model key is configured inside TrueForge's own Settings
# UI, which this app's process can't see). Without it, narration-less recordings still work;
# a step with `narration` set will fail with a clear "OPENAI_API_KEY is not set" tool error.
OPENAI_API_KEY=

# Optional. When set (and TRUEFORGE_BASE_URL is not), /api/agent/chat and /api/agent/confirm
# proxy to this SSE endpoint.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_ID=

# Required when AGENT_API_KEY is set. Send the same value from the browser.
HARNESS_SECRET=
NEXT_PUBLIC_HARNESS_SECRET=

# Optional. When set, Home revenue reads paid Stripe charges and invoices
# attributed to listed videos via metadata.video_id or metadata.post_id.
STRIPE_SECRET_KEY=
